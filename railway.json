{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && python manage.py collectstatic --noinput --clear"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "daphne -b 0.0.0.0 -p $PORT sportclub.asgi:application"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./sportclub/static/css/input.css -o ./sportclub/static/css/output.css --minify"
  }
}