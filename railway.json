{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["python310", "nodejs_20", "npm"]
        },
        "install": {
          "cmds": [
            "pip install -r requirements.txt",
            "npm install"
          ]
        },
        "build": {
          "cmds": [
            "npm run build:css",
            "python manage.py collectstatic --noinput --clear"
          ]
        }
      }
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "python manage.py migrate --noinput && daphne -b 0.0.0.0 -p $PORT sportclub.asgi:application"
  }
}